# Copy to .env and fill in your values:
#   cp .env.example .env
# Then run:
#   ./init.sh && docker compose up -d

# --- Cloudflare DNS API token (wildcard certificates) ---
# Required scopes: Zone → Zone → Read, Zone → DNS → Edit
# https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=your_cloudflare_api_token_here

# --- Let's Encrypt ---
ACME_EMAIL=you@example.com

# Use Let's Encrypt staging while testing to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Primary domain (wildcard + apex) ---
# example.com  →  covers example.com and *.example.com
PRIMARY_DOMAIN=example.com

# Extra wildcard domains are not enabled by default.
# See README.md → "Extra domains".

# --- Dashboard login (used by ./init.sh to build traefik/auth/users) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-now

# Comma-separated CIDRs allowed to open https://traefik.PRIMARY_DOMAIN
# Use 0.0.0.0/0,::/0 only if you accept exposing the dashboard to the internet.
DASHBOARD_ALLOWED_IPS=203.0.113.10/32

# --- Docker network shared with your other Compose stacks ---
DOCKER_NETWORK_NAME=web

# --- Published ports (host:container is always *:80 and *:443 inside) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Logging ---
TRAEFIK_LOG_LEVEL=ERROR
TRAEFIK_LOG_FORMAT=json
TRAEFIK_ACCESSLOG=false
TRAEFIK_ACCESSLOG_FORMAT=json

# Optional remote syslog (use with docker-compose.syslog.yml):
# LOG_SERVER_ADDRESS=udp://127.0.0.1:514
